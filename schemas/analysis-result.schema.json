        "status",
        "sourceId",
        "sourceUrl",
        "supportEligible",
        "supportWindowKeV",
        "independenceStatus",
        "supportExclusionReasons"
      ],
      "properties": {
        "lineId": {
          "type": "string"
        },
        "energyKeV": {
          "type": "number"
        },
        "intensityPercent": {
          "type": "number"
        },
        "foundPeakId": {
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "evidence.schema.json#/$defs/lineStatus"
        },
        "sourceId": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        },
        "supportEligible": {
          "type": "boolean"
        },
        "supportWindowKeV": {
          "type": [
            "number",
