{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/twinkle-air/nexus-naa/schemas/analysis-result.schema.json",
  "title": "Nexus-NAA analysis result V1.3",
  "type": "object",
  "required": [
    "schemaVersion",
    "skillContractVersion",
    "softwareVersion",
    "revision",
    "generatedAt",
    "source",
    "spectrum",
    "qc",
    "calibration",
    "peakSearch",
    "matchSettings",
    "peaks",
    "matching",
    "nuclideCandidates",
    "evidence",
    "database",
    "trace",
    "warnings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.4"
    },
    "skillContractVersion": {
      "const": "1.3.0"
    },
    "softwareVersion": {
      "const": "1.3.0"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "filename",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "spectrum": {
      "type": "object",
      "required": [
        "filename",
        "format",
        "channels",
        "counts",
        "warnings",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "channels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 1
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": 0
          },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "qc": {
      "$ref": "#/$defs/aQc"
    },
    "calibration": {
      "anyOf": [
        {
          "$ref": "#/$defs/aCalibration"
        },
        {
          "type": "null"
        }
      ]
    },
    "peakSearch": {
      "$ref": "#/$defs/aPeakSettings"
    },
    "matchSettings": {
      "$ref": "#/$defs/aMatchSettings"
    },
    "peaks": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aPeak"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "matching": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/aMatch"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "nuclideCandidates": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "evidence.schema.json"
      }
    },
    "evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/aEvidence"
        },
        {
          "type": "null"
        }
      ]
    },
    "database": {
      "anyOf": [
        {
          "$ref": "#/$defs/aDatabase"
        },
        {
          "type": "null"
        }
      ]
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "at": {
            "type": "string"
          },
          "sourceSchema": {
            "type": "string"
          },
          "recomputed": {
            "type": "boolean"
          }
        },
        "required": [
          "tool",
          "revision",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "aQc": {
      "type": "object",
      "properties": {
        "level": {
          "enum": [
            "pass",
            "warning"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "level": {
                "enum": [
                  "pass",
                  "warning"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "level",
              "detail"
            ],
            "additionalProperties": false
          }
        },
        "summary": {
          "type": "object",
          "properties": {
            "channelCount": {
              "type": "integer",
              "minimum": 1
            },
            "totalCounts": {
              "type": "number"
            },
            "meanCounts": {
              "type": "number"
            },
            "maxCounts": {
              "type": "number"
            },
            "maxChannel": {
              "type": "number"
            },
            "minChannel": {
              "type": "number"
            },
            "maxChannelNumber": {
              "type": "number"
            }
          },
          "required": [
            "channelCount",
            "totalCounts",
            "meanCounts",
            "maxCounts",
            "maxChannel",
            "minChannel",
            "maxChannelNumber"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "level",
        "checks",
        "summary"
      ],
      "additionalProperties": false
    },
    "aCalibration": {
      "type": "object",
      "properties": {
        "model": {
          "const": "linear"
        },
        "slope": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "intercept": {
          "type": "number"
        },
        "rmse": {
          "type": "number",
          "minimum": 0
        },
        "rSquared": {
          "type": "number"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "channel": {
                "type": "number"
              },
              "energyKeV": {
                "type": "number"
              },
              "predictedKeV": {
                "type": "number"
              },
              "residualKeV": {
                "type": "number"
              }
            },
            "required": [
              "channel",
              "energyKeV",
              "predictedKeV",
              "residualKeV"
            ],
            "additionalProperties": false
          },
          "minItems": 2
        },
        "pointCount": {
          "type": "integer",
          "minimum": 2
        },
        "validationStatus": {
          "enum": [
            "two_point_unverified",
            "limited_multipoint",
            "multipoint"
          ]
        },
        "referenceRangeChannel": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "referenceRangeKeV": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "model",
        "slope",
        "intercept",
        "rmse",
        "rSquared",
        "points",
        "pointCount",
        "validationStatus",
        "referenceRangeChannel",
        "referenceRangeKeV",
        "warnings"
      ],
      "additionalProperties": false
    },
    "aPeak": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "centroidIndex": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "prominence": {
          "type": "number"
        },
        "fwhmChannels": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "roiStart": {
          "type": "integer",
          "minimum": 0
        },
        "roiEnd": {
          "type": "integer",
          "minimum": 0
        },
        "netArea": {
          "type": "number"
        },
        "significance": {
          "type": "number"
        },
        "detectionMode": {
          "enum": [
            "adaptive",
            "snip",
            "global"
          ]
        },
        "backgroundMethod": {
          "enum": [
            "local_minima",
            "snip_lls_decreasing_window"
          ]
        },
        "widthMethod": {
          "type": "string"
        },
        "areaMethod": {
          "type": "string"
        },
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "centroidChannel": {
          "type": "number"
        },
        "energyKeV": {
          "type": [
            "number",
            "null"
          ]
        },
        "fwhmKeV": {
          "type": [
            "number",
            "null"
          ]
        },
        "overlapFit": {
          "type": "object",
          "properties": {
            "objective": {
              "type": "number"
            },
            "rmse": {
              "type": "number"
            },
            "background": {
              "type": "object",
              "properties": {
                "intercept": {
                  "type": "number"
                },
                "slopePerRoi": {
                  "type": "number"
                }
              },
              "required": [
                "intercept",
                "slopePerRoi"
              ],
              "additionalProperties": false
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "centerIndex": {
                    "type": "number"
                  },
                  "sigmaChannels": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "fwhmChannels": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "height": {
                    "type": "number"
                  },
                  "area": {
                    "type": "number"
                  }
                },
                "required": [
                  "centerIndex",
                  "sigmaChannels",
                  "fwhmChannels",
                  "height",
                  "area"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            },
            "roiStart": {
              "type": "integer",
              "minimum": 0
            },
            "roiEnd": {
              "type": "integer",
              "minimum": 0
            },
            "method": {
              "const": "bounded_grid_weighted_double_gaussian_linear_background"
            },
            "converged": {
              "type": "boolean"
            }
          },
          "required": [
            "objective",
            "rmse",
            "background",
            "components",
            "roiStart",
            "roiEnd",
            "method",
            "converged"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "index",
        "centroidIndex",
        "height",
        "prominence",
        "fwhmChannels",
        "roiStart",
        "roiEnd",
        "netArea",
        "significance",
        "detectionMode",
        "backgroundMethod",
        "widthMethod",
        "areaMethod",
        "channel",
        "centroidChannel",
        "energyKeV"
      ],
      "additionalProperties": false
    },
    "aSource": {
      "type": "object",
      "properties": {
        "name": {
